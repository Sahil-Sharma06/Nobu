# Copy to .env and fill in. Never commit .env.

# Database (Postgres via docker compose)
NOBU_DATABASE_URL=postgresql+psycopg://nobu:nobu@localhost:5432/nobu

# LLM: provider is one of stub | openai_compat | ollama | anthropic
NOBU_LLM_PROVIDER=stub
NOBU_LLM_MODEL=
# openai_compat: any OpenAI-compatible API, e.g.
#   NVIDIA:     https://integrate.api.nvidia.com/v1   model nvidia/nemotron-3-ultra-550b-a55b
#   Mistral:    https://api.mistral.ai/v1
#   OpenRouter: https://openrouter.ai/api/v1
NOBU_LLM_BASE_URL=
NOBU_LLM_API_KEY=
# ollama (local)
NOBU_OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=

# Sending guardrails
NOBU_DRY_RUN=true
NOBU_DAILY_CAP=15
NOBU_DEDUPE_DAYS=60

# Where uploaded resume and other user data live (gitignored)
NOBU_DATA_DIR=../data  # relative to backend/
